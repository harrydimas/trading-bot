API_KEY=your_api_key
SECRET=your_secret

# Telegram bot token (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Logging configuration (options: trace, debug, info, warn, error, fatal, silent)
LOG_LEVEL=info

SYMBOLS=BTC/USDT

BUY_USDT=10

# Partial Take Profit
PARTIAL_TP1_PCT=0.03        # jual 40% posisi saat profit 3%
PARTIAL_TP1_SIZE=0.4
PARTIAL_TP2_PCT=0.05        # jual 30% posisi saat profit 5%
PARTIAL_TP2_SIZE=0.3

# Trailing Stop
TRAILING_DEFAULT=0.015      # 1.5% sebelum TP apapun
TRAILING_AFTER_TP1=0.008    # 0.8% setelah TP1
TRAILING_AFTER_TP2=0.005    # 0.5% setelah TP2

# Break-Even
BREAK_EVEN_ARM_PCT=0.015    # arm setelah profit 1.5%

MAX_POSITIONS=5
MAX_BUDGET=100

MAX_SLIPPAGE=0.002

MIN_ORDER_USDT=6   # minimum notional value per sell order (Binance ~$5)

TAKER_FEE=0.001   # Binance taker fee (0.1%). Gunakan 0.00075 jika punya BNB discount

MAX_HOLD_MS=86400000   # Max hold time in ms (86400000 = 24 jam, 0 = disabled)

CHECK_INTERVAL=30000

DB_HOST=db
DB_PORT=5432
DB_USER=trader
DB_PASSWORD=traderpass
DB_NAME=trading
